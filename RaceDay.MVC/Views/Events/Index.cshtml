@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">

    <h1>Manage Events</h1>
    <p>View and manage RaceDay events.</p>

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary mb-3">
        Back to Dashboard
    </a>

    <a asp-controller="Events"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Add New Event
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 class="card-img-top"
                                 alt="@item.Title event banner"
                                 style="height:200px; object-fit:cover;" />
                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @item.Title
                            </h5>

                            <p class="card-text">
                                @item.Description
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd/MM/yyyy HH:mm")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                        </div>

                        <div class="card-footer bg-white">

                            <a asp-controller="Events"
                               asp-action="Edit"
                               asp-route-id="@item.EventId"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <form asp-controller="Events"
                                  asp-action="Delete"
                                  asp-route-id="@item.EventId"
                                  method="post"
                                  style="display:inline"
                                  onsubmit="return confirm('Are you sure you want to delete this event?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>