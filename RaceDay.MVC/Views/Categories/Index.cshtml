@model List<RaceDay.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container mt-5">

    <h1>Manage Race Categories</h1>
    <p>View and manage categories for your race events.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary mb-3">
        Back to Dashboard
    </a>

    <a asp-controller="Categories"
       asp-action="Create"
       class="btn btn-primary mb-3">
        Add New Category
    </a>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Category ID</th>
                        <th>Event ID</th>
                        <th>Category Name</th>
                        <th>Distance (km)</th>
                        <th>Entry Fee</th>
                        <th>Start Time</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryId</td>
                            <td>@category.EventId</td>
                            <td>@category.Name</td>
                            <td>@category.DistanceKm km</td>
                            <td>R @category.EntryFee.ToString("N2")</td>
                            <td>@category.StartTime.ToString("dd MMM yyyy HH:mm")</td>

                            <td>
                                <a asp-controller="Categories"
                                   asp-action="Edit"
                                   asp-route-id="@category.CategoryId"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form asp-controller="Categories"
                                      asp-action="Delete"
                                      asp-route-id="@category.CategoryId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this category?');">

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No categories are currently available.
        </div>
    }

</div>
