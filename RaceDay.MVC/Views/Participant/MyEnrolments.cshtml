@model List<RaceDay.MVC.Models.MyEnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">

    <h1>My Enrolments</h1>

    <p>View the race events and categories you have entered.</p>

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-secondary mb-3">
        Back to Dashboard
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>@enrolment.EventTitle</td>
                            <td>@enrolment.CategoryName</td>
                            <td>
                                @enrolment.EnrolmentDate.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    @enrolment.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>