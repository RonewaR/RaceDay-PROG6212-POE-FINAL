@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">

    <h1>Welcome to RaceDay!</h1>
    <p>Your personal race participation dashboard.</p>

    <div class="row mt-4">

        <!-- Upcoming Events -->
        <div class="col-md-4 mb-3">
            <div class="card p-4 shadow-sm">
                <h4>Upcoming Events</h4>
                <p>Explore available running events.</p>

                <a asp-controller="Participant"
                   asp-action="Events"
                   class="btn btn-primary">
                    Browse Events
                </a>
            </div>
        </div>

        <!-- My Enrolments -->
        <div class="col-md-4 mb-3">
            <div class="card p-4 shadow-sm">
                <h4>My Enrolments</h4>
                <p>View your event enrolments.</p>

                <a asp-controller="Participant"
                   asp-action="MyEnrolments"
                   class="btn btn-primary">
                    My Enrolments
                </a>
            </div>
        </div>

        <!-- Race Results -->
        <div class="col-md-4 mb-3">
            <div class="card p-4 shadow-sm">
                <h4>Race Results</h4>
                <p>Check your race results.</p>

                <a asp-controller="Participant"
                   asp-action="Results"
                   class="btn btn-primary">
                    View Results
                </a>
            </div>
        </div>

        <!-- My Profile -->
        <div class="col-md-4 mb-3">
            <div class="card p-4 shadow-sm">
                <h4>My Profile</h4>
                <p>View and manage your profile.</p>

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn btn-primary">
                    My Profile
                </a>
            </div>
        </div>

    </div>

    <!-- Logout -->
    <a asp-controller="Auth"
       asp-action="Logout"
       class="btn btn-danger mt-3">
        Logout
    </a>

</div>